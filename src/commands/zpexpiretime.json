{
    "ZPEXPIRETIME": {
        "summary": "Returns the Unix timestamp in milliseconds at which the given sorted set member(s) will expire.",
        "complexity": "O(N) where N is the number of specified members.",
        "group": "sorted_set",
        "since": "9.0.0",
        "arity": -5,
        "function": "zpexpiretimeCommand",
        "command_flags": [
            "READONLY",
            "FAST"
        ],
        "acl_categories": [
            "FAST",
            "READ",
            "SORTEDSET"
        ],
        "key_specs": [
            {
                "flags": [
                    "RO",
                    "ACCESS"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "reply_schema": {
            "description": "List of values associated with the result of getting the remaining time-to-live of the specific fields, in the same order as they are requested.",
            "type": "array",
            "minItems": 1,
            "items": {
                "oneOf": [
                    {
                        "description": "Member does not exist in the provided sorted set, or the sorted set is empty.",
                        "const": -2
                    },
                    {
                        "description": "Member exists in the provided sorted set, but has no expiration associated with it.",
                        "const": -1
                    },
                    {
                        "description": "The expiration Unix timestamp in milliseconds.",
                        "type": "integer",
                        "minimum": 0
                    }
                ]
            }
        },
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "members",
                "token": "MEMBERS",
                "type": "block",
                "arguments": [
                    {
                        "name": "nummembers",
                        "type": "integer",
                        "key_spec_index": 0,
                        "multiple": false,
                        "minimum": 1
                    },
                    {
                        "name": "member",
                        "type": "string",
                        "multiple": true
                    }
                ]
            }
        ]
    }
}
