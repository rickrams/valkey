{
    "ZPERSIST": {
        "summary": "Remove the existing expiration on sorted set member(s).",
        "complexity": "O(N) where N is the number of specified members.",
        "group": "sorted_set",
        "since": "9.0.0",
        "arity": -5,
        "function": "zpersistCommand",
        "command_flags": [
            "WRITE",
            "FAST"
        ],
        "acl_categories": [
            "FAST",
            "SORTEDSET",
            "WRITE"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "reply_schema": {
            "description": "List of integer codes indicating the result of setting expiry on each specified field, in the same order as the fields are requested.",
            "type": "array",
            "minItems": 1,
            "items": {
                "oneOf": [
                    {
                        "description": "Member does not exist in the provided sorted set, or the sorted set does not exist.",
                        "const": -2
                    },
                    {
                        "description": "Member exists in the provided sorted set, but has no expiration associated with it.",
                        "const": -1
                    },
                    {
                        "description": "The expiration time was removed from the sorted set member.",
                        "const": 1
                    }
                ]
            }
        },
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "members",
                "token": "MEMBERS",
                "type": "block",
                "arguments": [
                    {
                        "name": "nummembers",
                        "type": "integer",
                        "key_spec_index": 0,
                        "multiple": false,
                        "minimum": 1
                    },
                    {
                        "name": "member",
                        "type": "string",
                        "multiple": true
                    }
                ]
            }
        ]
    }
}
